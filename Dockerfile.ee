# bodesign-ee — electronics-engineering worker (C03/C04/C06). Batch E Phase 2.
#
# The KiCad/ngspice toolbox only: schematic → layout → simulate/EMC/thermal →
# fab/BOM/netlist. NO LibreOffice, NO OpenSCAD, NO build123d. Runs the same bodesign
# server with `--tools ee`; the core forwards the EE tools here and both share the
# session volume.
#
# Build: docker build -f Dockerfile.ee -t bodesign-ee:latest .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1 \
    PYTHONDONTWRITEBYTECODE=1

# KiCad 9 (kicad-cli + pcbnew + symbol/footprint libs) + ngspice for SPICE.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        software-properties-common gnupg ca-certificates curl \
        python3 python3-venv python3-pip ngspice \
        poppler-utils \
        default-jre xvfb wget \
 && wget -q -O /opt/freerouting.jar https://github.com/freerouting/freerouting/releases/download/v1.9.0/freerouting-1.9.0.jar \
 && add-apt-repository -y ppa:kicad/kicad-9.0-releases \
 && apt-get update \
 && apt-get install -y --no-install-recommends kicad kicad-symbols kicad-footprints \
 && rm -rf /var/lib/apt/lists/*

# venv with system site-packages so the apt-installed pcbnew module is importable.
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY services/mcp/requirements.txt /app/services/mcp/requirements.txt
RUN pip install --no-cache-dir -r /app/services/mcp/requirements.txt \
 && kicad-cli version

# atopile declarative-DSL compiler (plans/dsl_atopile-integration DD-1/DD-2):
# pinned version, fail-loud presence check (mirrors the kicad-cli check above).
# atopile 0.12.x requires Python 3.13 (system venv is 3.12 for apt pcbnew), so it
# lives in its own uv-managed toolchain; only the `ato` CLI is exposed on PATH.
RUN pip install --no-cache-dir uv \
 && UV_TOOL_BIN_DIR=/usr/local/bin uv tool install --python 3.13 atopile==0.12.5 \
 && ato --version

# elkjs layered presentation engine (DD-15; DD-9 clearance:
# plans/eda-bridge_unified-collaborative-rebuild/dd9-clearance-elkjs.md, conditions 3-6).
# Node = official nodejs.org 22.x maintenance-LTS tarball, pinned patch + platform,
# sha256 checked against SHASUMS256.txt (that file's detached signature was verified
# with the nodejs release key 5BE8A3F6C8A5C01D106C0AD820B1A390B168D356 on
# 2026-10-06; the digest below is copied from it). No NodeSource, no apt node.
# Unsupported arch fails explicitly. Node/npm bundled licenses are retained
# under /opt/node (LICENSE + node_modules/npm/LICENSE). xz-utils is the only
# system prerequisite for the .tar.xz extraction.
ARG NODE_VERSION=22.23.3
ARG NODE_SHA256_LINUX_X64=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in x86_64) node_arch=x64; node_sha="${NODE_SHA256_LINUX_X64}" ;; \
      *) echo "E_NODE_ARCH_UNSUPPORTED: no pinned Node ${NODE_VERSION} digest for ${arch}" >&2; exit 1 ;; esac; \
    apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*; \
    curl -fsSLo /opt/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    echo "${node_sha}  /opt/node.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/node && tar -xJf /opt/node.tar.xz -C /opt/node --strip-components=1; \
    rm /opt/node.tar.xz; \
    /opt/node/bin/node --version; /opt/node/bin/npm --version
ENV PATH="/opt/node/bin:$PATH" BODESIGN_NODE_BIN=/opt/node/bin/node

# Lockfile-based production dependency layer: exactly elkjs@0.12.0 (integrity in
# the lock equals the clearance value; `npm ci` fails loud on mismatch). No
# globals, no lifecycle scripts, web-worker stays out. Installed BEFORE the
# `COPY packages` below so a code-only change does not re-run npm.
WORKDIR /app/packages/eda-bridge/elk
COPY packages/eda-bridge/elk/package.json packages/eda-bridge/elk/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && test "$(npm ls --all --parseable --omit=dev | grep -c node_modules)" = "1"
WORKDIR /app

COPY packages /app/packages
# Re-verify AFTER the COPY layer: the installed elkjs must still be exactly the
# npm-ci'd 0.12.0 whose integrity the lockfile pins (a host node_modules copied
# over it would be caught here; .dockerignore also excludes it).
RUN cd /app/packages/eda-bridge/elk \
 && test "$(npm ls --all --parseable --omit=dev | grep -c node_modules)" = "1" \
 && node -e "const p=require('elkjs/package.json'); if (p.version!=='0.12.0') throw new Error('elkjs '+p.version); require('elkjs/lib/elk.bundled.js'); console.log('elkjs', p.version, 'ok')"
COPY services /app/services

# R9 skill-shipping BOTH halves from ONE source + R15 usage-doctrine one-source
# (matches monolith Dockerfile — keep the four in sync). This worker also runs
# run_http, whose startup parity gate (assert_skill_source_parity) reads mcp.json
# and the tree it declares and REFUSES TO BIND if they disagree (BR_20260730).
# This COPY also satisfies _DOCTRINE_PATH = <app>/skills/bodesign/doctrine.md,
# which _load_doctrine() FAILS LOUD on if missing/empty (天條 11).
COPY mcp.json /app/mcp.json
COPY skills /app/skills

# Bundle the analyzer engine SCRIPTS (kicad/spice/emc) the EE-group C06 verification
# tools resolve via resolve_skill(). This worker already ships kicad-cli + ngspice;
# these are the engine scripts that drive them. Without them, simulate / analyze_emc /
# analyze_thermal return `skipped-no-skills`.
#
# kicad comes from the in-repo tree (the same source /skills serves, and fresher
# than the retired tarball: 78 files vs 50). spice + emc have NO in-repo source —
# they are vendored EDA companions — so they still come from their tarballs; that
# asymmetry is deliberate and is why those two are NOT advertised as R9 skills.
# Build FAILS LOUD if any scripts/ dir is missing. Mirrors the monolith Dockerfile
# — keep the two in sync.
RUN set -eu; \
    mkdir -p /opt/bodesign-engines/bodesign/engines; \
    cp -r /app/skills/bodesign/engines/kicad /opt/bodesign-engines/bodesign/engines/kicad; \
    tar xzf /app/services/mcp/assets/skills/spice.tar.gz    -C /opt/bodesign-engines spice; \
    tar xzf /app/services/mcp/assets/skills/emc.tar.gz      -C /opt/bodesign-engines emc; \
    test -d /opt/bodesign-engines/bodesign/engines/kicad/scripts; \
    test -d /opt/bodesign-engines/spice/scripts; \
    test -d /opt/bodesign-engines/emc/scripts

ENV PYTHONPATH="/app/packages/shared:/app/packages/design-ir:/app/packages/component-knowledge:/app/packages/component-kb:/app/packages/doc-core:/app/packages/source-core:/app/packages/reverse-core:/app/packages/gerber-core:/app/packages/eda-bridge:/app/packages/workflow-core:/app/packages/storage-core:/app/packages/kicad-plugin:/app/services/mcp:/app" \
    KICAD_SYMBOL_DIR=/usr/share/kicad/symbols \
    KICAD_FOOTPRINT_DIR=/usr/share/kicad/footprints \
    BODESIGN_SESSIONS_ROOT=/var/cache/bodesign/sessions \
    BODESIGN_KICAD_SKILL=/opt/bodesign-engines/bodesign/engines/kicad \
    BODESIGN_SPICE_SKILL=/opt/bodesign-engines/spice \
    BODESIGN_EMC_SKILL=/opt/bodesign-engines/emc

# uid-aligned privilege drop (BR_20260705_work_dir_root_owned): start as root,
# chown the writable mounts to HOST_UID/HOST_GID, re-exec dropped via setpriv.
ENTRYPOINT ["sh", "/app/services/mcp/docker-entrypoint.sh"]
# Serve only the electronics-engineering tool group on the internal compose network.
CMD ["--transport", "http", "--host", "0.0.0.0", "--port", "8077", "--tools", "ee"]
ENV FREEROUTING_JAR=/opt/freerouting.jar JAVA_BIN=java
