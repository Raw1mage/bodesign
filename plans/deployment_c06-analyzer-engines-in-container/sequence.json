      {"id": "MSG7", "from": "P5", "to": "P2", "label": "simulation output", "kind": "reply"},
      {"id": "MSG8", "from": "P2", "to": "P1", "label": "real verdict {status: pass|warn|fail} — never skipped-no-skills", "kind": "reply"}
    ]
  },
