[
  {
    "id": "SEQ1",
    "name": "Extraction ingest with per-row evidence validation",
    "requirementRefs": ["R1", "R2"],
    "participants": [
      { "id": "P1", "name": "Design Engineer / Extractor", "componentRef": null },
      { "id": "P2", "name": "Extraction Ingester", "componentRef": "C2" },
      { "id": "P3", "name": "Field Path Registry", "componentRef": "C1" },
      { "id": "P4", "name": "Vault L4 (spec_values)", "componentRef": null }
    ],
    "messages": [
      { "id": "MSG1", "from": "P1", "to": "P2", "label": "ingest_spice_extraction(mpn, rows[])", "kind": "sync" },
