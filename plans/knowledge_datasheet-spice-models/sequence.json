      { "id": "MSG3", "from": "P3", "to": "P2", "label": "canonical path | SPX_FIELD_UNKNOWN (row rejected)", "kind": "sync" },
      { "id": "MSG4", "from": "P2", "to": "P2", "label": "validate evidence (sha256 + page) -> SPX_EVIDENCE_MISSING per-row reject; not_found rows never written", "kind": "self" },
      { "id": "MSG5", "from": "P2", "to": "P4", "label": "insert valid rows trust=unverified + evidence_ref", "kind": "sync" },
      { "id": "MSG6", "from": "P2", "to": "P1", "label": "IngestReport {written, rejected, not_found}", "kind": "sync" }
    ]
  },
  {
