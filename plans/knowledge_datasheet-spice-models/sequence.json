      { "id": "P4", "name": "Card Materializer", "componentRef": "C4" },
      { "id": "P5", "name": "ngspice", "componentRef": null }
    ],
    "messages": [
      { "id": "MSG1", "from": "P1", "to": "P2", "label": "bodesign_spice_model_card {folder, mpn, category, materialize}", "kind": "sync" },
      { "id": "MSG2", "from": "P2", "to": "P3", "label": "generate_model_card(mpn, category)", "kind": "sync" },
      { "id": "MSG3", "from": "P3", "to": "P3", "label": "query L4; typ-selection; SPX_PARAMS_MISSING/AMBIGUOUS if incomplete", "kind": "self" },
