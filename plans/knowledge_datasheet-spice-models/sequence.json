      { "id": "MSG6", "from": "P5", "to": "P4", "label": "exit code + stderr (pass | fail | unavailable)", "kind": "sync" },
      { "id": "MSG7", "from": "P4", "to": "P4", "label": "pass/skipped -> write card + manifest(source=vault-grounded); fail -> SPX_SMOKE_FAILED, exclude", "kind": "self" },
      { "id": "MSG8", "from": "P2", "to": "P1", "label": "ModelCard JSON (card_text, provenance, smoke) | SPX_* error", "kind": "sync" }
    ]
  },
  {
