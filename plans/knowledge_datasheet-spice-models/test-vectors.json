  },
  {
    "id": "TV-R3-05",
    "requirement": "R3",
    "name": "multiple rows without typ fails fast (no averaging)",
    "input": {
      "call": "generate_model_card",
      "mpn": "D-TEST-1N4148",
      "category": "diode",
      "l4_state": "is_a has min=1e-9 and max=5e-9 rows, no typ; n=1.752(typ)"
