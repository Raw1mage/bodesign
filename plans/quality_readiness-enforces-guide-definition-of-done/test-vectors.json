[
  {"$comment": "Mirrors tests/test_guide_dod.py — deterministic input/expected pairs.",
   "id": "TV1", "name": "placeholders flagged",
   "input": {"fn": "is_placeholder_value", "values": ["TBC", "TBD", "N/A", "to be confirmed", "待補充", "未定", "", null, {}]},
   "expect": {"all": true}},
  {"id": "TV2", "name": "legit values NOT flagged (false-positive corpus)",
   "input": {"fn": "is_placeholder_value", "values": ["STM32N657L0 (4.2MB SRAM, 600 Gops Neural-ART)", "3.3V", "802.11 b/g/n", "期待機制,待機電流 5uA", "CYW43439 Wi-Fi/BLE", {"rail": "VBAT"}, 5]},
   "expect": {"all": false}},
  {"id": "TV3", "name": "real TBC inside a long substantive value still caught",
   "input": {"fn": "is_placeholder_value", "value": "STM32N657 … MPNs/stock TBC (no DigiKey API)."},
   "expect": true},
  {"id": "TV4", "name": "empty stage -> all missing/blocking",
   "input": {"fn": "assess_guide_dod", "base": "<empty dir>", "stage": "c05"},
   "expect": {"dod_ok": false, "missing_blocking_count": 6}},
  {"id": "TV5", "name": "complete stage -> green",
   "input": {"fn": "assess_guide_dod", "base": "<c05 all 6 files>", "stage": "c05"},
   "expect": {"dod_ok": true, "missing_blocking": []}},
  {"id": "TV6", "name": "honest-status override not blocking",
   "input": {"fn": "assess_guide_dod", "stage": "c02", "missing": "enclosure_export", "dod_status": {"enclosure_export": {"status": "not-run", "reason": "no OpenSCAD"}}, "conditions": {"toolchain": true}},
   "expect": {"enclosure_export_status": "honest-status", "dod_ok": true}},
  {"id": "TV7", "name": "conditional skipped when unknown",
   "input": {"fn": "assess_guide_dod", "stage": "c06", "files": ["Verification_Summary.json", "Test_Plan.md", "Bring_Up_Checklist.md", "analysis/cross_verify.json"]},
   "expect": {"evt_findings_status": "n-a", "dod_ok": true}},
  {"id": "TV8", "name": "all_of needs every file",
   "input": {"fn": "assess_guide_dod", "stage": "c04", "files_then": [["Layout_Constraints.json"], ["Layout_Constraints.json", "Placement_Constraints.md"]]},
   "expect": {"layout_placement": ["missing", "present"]}},
  {"id": "TV9", "name": "c00 fake-complete field blocks",
   "input": {"fn": "assess_c00_prd_readiness", "field": {"value": "MPNs TBC", "state": "answered"}},
   "expect": {"in_fake_complete_fields": true, "dod_ok": false}},
  {"id": "TV10", "name": "c00 radio part + include_rf=false blocks",
   "input": {"fn": "assess_c00_prd_readiness", "field": {"value": "MCU + CYW43439 Wi-Fi/BLE", "state": "answered"}, "include_rf": false},
   "expect": {"dod_ok": false, "warning_contains": "RF appendix required"}},
  {"id": "TV11", "name": "clean c00 state -> dod_ok",
   "input": {"fn": "assess_c00_prd_readiness", "field": {"value": "5V 2A USB-C", "state": "answered"}, "include_rf": false},
   "expect": {"dod_ok": true}},
  {"id": "TV12", "name": "every stage manifest loads with guide_row",
   "input": {"fn": "load_manifest", "stages": ["c00", "c01", "c02", "c03", "c04", "c05", "c06", "c07"]},
   "expect": {"all_non_null": true, "every_deliverable_has_guide_row": true}}
]
