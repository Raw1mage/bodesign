{
  "$comment": "Concrete input/expected pairs for emit_c03_host_block_diagram. Mirrors test_c03_partition_diagram.py style.",
  "vectors": [
    {
      "id": "TV1-valid-full",
      "desc": "aiguard-style host MODEL: center SoC + peripherals all four sides + reference_baseline",
      "input": {
        "title": "aiguard Host Block Diagram",
        "center_part": { "name": "STM32N657L0H3Q", "mpn": "STM32N657L0H3Q", "type": "soc" },
        "peripherals": [
          { "name": "Octal Flash", "side": "left", "type": "memory", "bus": "XSPI1" },
          { "name": "PSRAM", "side": "left", "type": "memory", "bus": "XSPI2" },
          { "name": "microSD", "side": "left", "type": "connector", "bus": "SDMMC" },
          { "name": "Wi-Fi/BLE", "side": "top", "type": "rf", "bus": "SDIO" },
          { "name": "MIPI 5->1 mux", "side": "right", "type": "connector", "bus": "CSI" },
          { "name": "Touch OLED", "side": "right", "type": "connector", "bus": "I2C+SPI" },
          { "name": "USB-C", "side": "right", "type": "connector", "bus": "USB2" },
          { "name": "18650 power chain", "side": "bottom", "type": "power", "bus": "VSYS" }
        ],
        "reference_baseline": {
          "name": "OpenMV N6",
          "diffs": ["no Ethernet PHY", "5 module sockets via MIPI 5->1 mux", "18650 battery vs USB-only", "touch OLED added"],
          "sourcing_gates": ["MIPI mux MPN pending", "18650 charger MPN pending"]
        }
      },
      "expect": {
        "status": "ok",
        "layers": ["center", "peripherals", "buses", "legend", "annotations"],
        "peripherals_count": 8,
        "svg_contains": ["center-STM32N657L0H3Q", "peripheral-Octal Flash", "bus-Wi-Fi/BLE", "derived from OpenMV N6", "functional block diagram, not a netlist"],
        "placeholders": []
      }
    },
    {
      "id": "TV2-missing-center-name",
      "desc": "center_part missing name -> fail fast",
      "input": {
        "center_part": { "mpn": "X" },
        "peripherals": [ { "name": "A", "side": "top" } ]
      },
      "expect": { "status": "missing", "missing_fields_contains": ["center_part.name"] }
    },
    {
      "id": "TV3-empty-peripherals",
      "desc": "peripherals empty -> fail fast",
      "input": {
        "center_part": { "name": "SoC" },
        "peripherals": []
      },
      "expect": { "status": "missing", "missing_fields_contains": ["peripherals"] }
    },
    {
      "id": "TV4-invalid-side",
      "desc": "peripheral side not in enum -> fail fast with invalid marker",
      "input": {
        "center_part": { "name": "SoC" },
        "peripherals": [ { "name": "A", "side": "northwest" } ]
      },
      "expect": { "status": "missing", "missing_fields_contains": ["peripherals[0].side(invalid:northwest)"] }
    },
    {
      "id": "TV5-unknown-type-placeholder",
      "desc": "unknown peripheral type -> dashed placeholder, not dropped",
      "input": {
        "center_part": { "name": "SoC", "type": "soc" },
        "peripherals": [ { "name": "Mystery", "side": "top", "type": "quantum-thing" } ]
      },
      "expect": {
        "status": "ok",
        "placeholders_contains": ["Mystery"],
        "svg_contains": ["(placeholder)", "stroke-dasharray"]
      }
    },
    {
      "id": "TV6-determinism",
      "desc": "same MODEL emitted twice (different folders) -> byte-identical SVG",
      "input": "use TV1 input",
      "expect": { "svg_byte_identical_across_two_emits": true }
    },
    {
      "id": "TV7-no-reference-baseline",
      "desc": "absent reference_baseline -> no derived-from block (no fabricated baseline)",
      "input": {
        "center_part": { "name": "SoC", "type": "soc" },
        "peripherals": [ { "name": "USB-C", "side": "right", "type": "connector" } ]
      },
      "expect": {
        "status": "ok",
        "svg_not_contains": ["derived from"]
      }
    },
    {
      "id": "TV8-lopsided-sides",
      "desc": "all peripherals on one side -> no overlap/overflow (R1 edge case)",
      "input": {
        "center_part": { "name": "SoC", "type": "soc" },
        "peripherals": [
          { "name": "P1", "side": "left", "type": "memory" },
          { "name": "P2", "side": "left", "type": "memory" },
          { "name": "P3", "side": "left", "type": "memory" },
          { "name": "P4", "side": "left", "type": "memory" },
          { "name": "P5", "side": "left", "type": "memory" }
        ]
      },
      "expect": { "status": "ok", "peripherals_count": 5 }
    }
  ]
}
