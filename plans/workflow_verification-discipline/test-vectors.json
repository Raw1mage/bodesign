        { "requirement_key": "usb_dp_dm_skew", "verdict": "unverified" },
        { "requirement_key": "net_parity", "verdict": "fail" }
      ],
      "invariant": "usb_dp_dm_skew has no oracle execution record => stays unverified, never inferred pass (DD-9)"
    }
