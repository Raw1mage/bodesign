{
  "stage": "c04",
  "guide": "skills/bodesign/stages/c04-layout/GUIDE.md",
  "base": "project-root",
  "honest_states": [
    "drafted",
    "pending",
    "not-run",
    "blocked"
  ],
  "deliverables": [
    {
      "id": "layout_placement",
      "title": "Layout + placement constraints",
      "guide_row": 1,
      "all_of": [
        "C04-Layout/Layout_Constraints.json",
        "C04-Layout/Placement_Constraints.md"
      ],
      "required": true,
      "any_of": []
    },
    {
      "id": "stackup_routing",
      "title": "Stackup + routing rules",
      "guide_row": 2,
      "all_of": [
        "C04-Layout/Stackup.md",
        "C04-Layout/Routing_Rules.md"
      ],
      "required": true,
      "any_of": []
    },
    {
      "id": "routed_board",
      "title": "Routed board + DRC report",
      "guide_row": 3,
      "all_of": [
        "C04-Layout/*.kicad_pcb",
        "C04-Layout/*.drc.rpt"
      ],
      "required": true,
      "honest_states": [
        "pending",
        "not-run"
      ],
      "any_of": []
    },
    {
      "id": "gerbers_drill",
      "title": "Gerbers + drill",
      "guide_row": 4,
      "all_of": [
        "C04-Layout/gerbers/",
        "C04-Layout/drill/"
      ],
      "required": true,
      "honest_states": [
        "pending",
        "not-run"
      ],
      "any_of": []
    },
    {
      "id": "assembly_package",
      "title": "Assembly package (CPL/IPC-2581/drawing)",
      "guide_row": 5,
      "any_of": [
        "C04-Layout/*CPL*.csv",
        "C04-Layout/*.ipc2581*",
        "C04-Layout/*assembly*draw*"
      ],
      "required": true,
      "honest_states": [
        "pending",
        "not-run"
      ]
    },
    {
      "id": "copper_renders",
      "title": "Per-layer copper PNGs + fab view",
      "guide_row": 6,
      "any_of": [
        "C04-Layout/02_build/copper_layers/",
        "C04-Layout/02_build/renders/"
      ],
      "required": true,
      "honest_states": [
        "pending",
        "not-run"
      ]
    },
    {
      "id": "lengthmatch_si",
      "title": "Length-match + SI reports",
      "guide_row": 7,
      "any_of": [
        "C04-Layout/03_output/*.lengthmatch.json",
        "C04-Layout/*.lengthmatch.json",
        "C04-Layout/03_output/*.si.json",
        "C04-Layout/*.si.json"
      ],
      "required": false,
      "condition": "high_speed"
    }
  ]
}