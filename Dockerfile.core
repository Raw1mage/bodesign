# bodesign-core — lean front + light-skill brain. Batch E Phase 3.
#
# The single externally-facing MCP. Carries ONLY light deps (mcp/starlette/uvicorn,
# pygerber for gerber rasters) + the bodesign packages + pm-skills/plan-builder/self-
# built skills (markdown). NO KiCad, NO LibreOffice, NO OpenSCAD, NO build123d — those
# live in the me/ee/docs workers; the core forwards their tool groups. A core tool
# whose worker is absent reports worker_unavailable (never fabricates).
#
# Build: docker build -f Dockerfile.core -t bodesign-core:latest .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# LibreDWG: build dxf2dwg/dwg2dxf/dwgread statically from source so the core's
# DXF<->DWG conversion tools (bodesign_dxf_to_dwg / bodesign_dwg_to_dxf) have no
# runtime shared-lib deps. build-essential/pkg-config are purged in the same
# layer to keep the binaries without the toolchain weight.
ARG LIBREDWG_VERSION=0.13.3
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential pkg-config curl ca-certificates xz-utils \
 && curl -fsSL "https://ftp.gnu.org/gnu/libredwg/libredwg-${LIBREDWG_VERSION}.tar.xz" -o /tmp/libredwg.tar.xz \
 && mkdir -p /tmp/libredwg && tar -xf /tmp/libredwg.tar.xz -C /tmp/libredwg --strip-components=1 \
 && cd /tmp/libredwg \
 && ./configure --disable-bindings --disable-python --disable-shared --enable-static --disable-dependency-tracking \
 && make -j"$(nproc)" \
 && install -m 0755 programs/dxf2dwg programs/dwg2dxf programs/dwgread /usr/local/bin/ \
 && cd / && rm -rf /tmp/libredwg /tmp/libredwg.tar.xz \
 && apt-get purge -y build-essential pkg-config \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY services/mcp/requirements.txt /app/services/mcp/requirements.txt
RUN pip install --no-cache-dir -r /app/services/mcp/requirements.txt

COPY packages /app/packages
COPY services /app/services

# R9 skill-shipping BOTH halves from ONE source + R15 usage-doctrine one-source
# (matches monolith Dockerfile — keep the four in sync). The core is the image
# that actually SERVES `GET /skills`, so it needs the R9.1 declaration (mcp.json)
# and the tree that declaration names; server.py asserts their parity at startup
# and refuses to bind otherwise (BR_20260730). This COPY also satisfies
# _DOCTRINE_PATH = <app>/skills/bodesign/doctrine.md, which _load_doctrine()
# FAILS LOUD on if missing/empty (天條 11).
COPY mcp.json /app/mcp.json
COPY skills /app/skills

ENV PYTHONPATH="/app/packages/shared:/app/packages/design-ir:/app/packages/component-knowledge:/app/packages/component-kb:/app/packages/doc-core:/app/packages/source-core:/app/packages/reverse-core:/app/packages/gerber-core:/app/packages/eda-bridge:/app/packages/workflow-core:/app/packages/storage-core:/app/packages/kicad-plugin:/app/services/mcp:/app" \
    BODESIGN_SESSIONS_ROOT=/var/cache/bodesign/sessions

# uid-aligned privilege drop (BR_20260705_work_dir_root_owned): start as root,
# chown the writable mounts to HOST_UID/HOST_GID, re-exec dropped via setpriv.
ENTRYPOINT ["sh", "/app/services/mcp/docker-entrypoint.sh"]
CMD ["--transport", "stdio"]
