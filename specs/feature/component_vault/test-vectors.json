  {
    "id": "TV-R3-1",
    "requirement": "R3",
    "name": "chunk ingest carries anchor + extractor",
    "input": {
      "op": "ingest_chunks",
      "document": "ds_ap2112k.pdf",
      "chunks": [
        {
          "chunk_kind": "table",
          "page_number": 5,
          "anchor": {
            "bbox": [
              40,
              120,
              520,
              380
            ]
          },
          "content": "Dropout Voltage 250 mV @ 300mA",
          "extractor": "docxmcp@1.4"
        }
      ]
    },
    "expect": {
      "chunk_count": 1,
      "fts_indexed": true
    }
  },
  {
    "id": "TV-R3-2",
    "requirement": "R3",
    "name": "FTS search returns BM25-ranked hit with page anchor",
    "input": {
      "op": "search_chunks",
      "query": "dropout voltage"
    },
    "expect": {
      "min_hits": 1,
      "first_hit_fields": [
        "mpn",
        "document",
        "page_number"
      ]
    }
  },
  {
    "id": "TV-R3-3",
    "requirement": "R3",
    "name": "extractor upgrade marks old chunks stale, keeps them",
    "setup": [
      {
        "op": "ingest_chunks",
        "document": "ds_ap2112k.pdf",
        "extractor": "docxmcp@1.4",
        "chunk_count": 3
      }
    ],
    "input": {
      "op": "ingest_chunks",
      "document": "ds_ap2112k.pdf",
      "extractor": "docxmcp@1.5",
      "chunk_count": 3
    },
    "expect": {
      "stale_chunks": 3,
      "active_chunks": 3,
      "deleted_chunks": 0
    }
  },
