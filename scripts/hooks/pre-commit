#!/usr/bin/env bash
# bodesign pre-commit — untracked issue-ledger guard (BR_20260802)
#
# WARNS LOUDLY, NEVER BLOCKS. Blocking would push people to --no-verify, which
# disables every future hook too — a worse outcome than the defect this catches.
#
# Why this exists: issues/ BRs were being committed when ARCHIVED and never when
# FILED, so the open-issue ledger lived in one working tree only. An untracked BR
# is indistinguishable from a tracked one under ls/cat/grep/editor — the absent
# state and the healthy state render the same. This is the one step that runs at
# the decision point (commit time) instead of relying on anyone remembering.

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo_root" || exit 0

# Only the issue ledger. Deliberately narrow: this tree carries a lot of
# legitimately-uncommitted work, and a chatty hook becomes noise, which is
# exactly how the original signal got lost.
mapfile -t untracked < <(
  git ls-files --others --exclude-standard -- 'issues/*.md' 'issues/**/*.md' 2>/dev/null
)

[ ${#untracked[@]} -eq 0 ] && exit 0

printf '\n' >&2
printf '\033[1;33m┌─ ISSUE LEDGER WARNING ─────────────────────────────────────────\033[0m\n' >&2
printf '\033[1;33m│\033[0m %d issue file(s) are NOT under version control:\n' "${#untracked[@]}" >&2
printf '\033[1;33m│\033[0m\n' >&2
for f in "${untracked[@]}"; do
  printf '\033[1;33m│\033[0m   \033[0;31m??\033[0m %s\n' "$f" >&2
done
printf '\033[1;33m│\033[0m\n' >&2
printf '\033[1;33m│\033[0m These exist in THIS working tree only — no history, no recovery,\n' >&2
printf '\033[1;33m│\033[0m invisible to any clone, and one `git clean -fd` deletes them\n' >&2
printf '\033[1;33m│\033[0m silently. See issues/BR_20260802_issues_ledger_committed_on_archive_not_on_filing.md\n' >&2
printf '\033[1;33m│\033[0m\n' >&2
printf '\033[1;33m│\033[0m To include them:  git add %s\n' "${untracked[0]}" >&2
printf '\033[1;33m│\033[0m Intentionally out? Nothing to do — this commit proceeds.\n' >&2
printf '\033[1;33m└────────────────────────────────────────────────────────────────\033[0m\n' >&2
printf '\n' >&2

# ── Status-schema check (BR_20260804l) ──────────────────────────────────────
# Surface any top-level BR with ZERO Status line — a reader cannot tell if it is
# open. WARN-only here too: we print the checker's ERROR output but never block,
# same reasoning as above (blocking -> --no-verify -> every hook disabled).
if [ -x scripts/check_issue_headers.sh ]; then
  if ! scripts/check_issue_headers.sh >/dev/null 2>&1; then
    printf '\n\033[1;33m┌─ ISSUE STATUS-SCHEMA WARNING ──────────────────────────────────\033[0m\n' >&2
    printf '\033[1;33m│\033[0m A top-level BR has no Status line anywhere (details below).\n' >&2
    printf '\033[1;33m│\033[0m See issues/README.md — Status line schema (BR_20260804l).\n' >&2
    printf '\033[1;33m└────────────────────────────────────────────────────────────────\033[0m\n' >&2
    scripts/check_issue_headers.sh >&2 2>&1 || true
  fi
fi

# Never block.
exit 0
